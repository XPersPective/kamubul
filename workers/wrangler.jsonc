{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kamubul-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "account_id": "5c5871cee9d16a81a908008f2a3de9af",
  "workers_dev": true,
  "assets": { "directory": "./public" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "ai": { "binding": "AI" },
  "d1_databases": [{"binding":"DB","database_name":"kamubul","database_id":"371092dd-2cc7-487f-b971-84c2499bbc7d","migrations_dir":"migrations"}],
  "queues": {
    "producers": [{"binding":"WORK_QUEUE","queue":"kamubul-work"}],
    "consumers": [{"queue":"kamubul-work","max_batch_size":1,"max_batch_timeout":1,"max_retries":0,"max_concurrency":1}]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "kamubul-3ae6e",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "AI_DAILY_JOBS": "2000",
    "AI_SUMMARY_ENABLED": "0",
    "EXTRACT_AI_PROVIDER": "external",
    "EXTRACT_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "EXTRACT_QWEN_DAILY": "10000",
    "EXTRACT_QWEN_HOURLY": "2000",
    "EXTRACT_DAILY_GLOBAL": "20000",
    "PDF_DAILY_JOBS": "1000",
    "AI_PROVIDER": "external",
    "EXTERNAL_AI_URL": "https://token-plan.maas.qwencloudapi.com/compatible-mode/v1",
    "EXTERNAL_AI_MODEL": "qwen3.8-flash",
    "ASSISTANT_AI_MODEL": "qwen3.6-flash",
    "ASSISTANT_DAILY_INSTALL": "10",
    "ASSISTANT_DAILY_PRO": "50",
    "ASSISTANT_DAILY_GLOBAL": "100000",
    "ASSISTANT_DAILY_IP": "100000",
    "EXTERNAL_AI_FORMAT": "openai",
    "EXTERNAL_AI_NOTHINK": "1",
    "SOURCE_INTERVAL_MINUTES": "60"
  },
  "triggers": { "crons": ["* * * * *"] }
}
