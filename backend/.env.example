# Gerçek değerleri buraya yazmayın; ortam değişkeni ya da Secret Manager kullanın.

# --- depolama ve bildirim ---
# STORAGE=firestore   # Google öncelikli; varsayılan file (taşınabilir)
# GCP_PROJECT=proje-kimligi
# PUSH=fcm            # log (varsayılan) | fcm | off
# DATA_DIR=data       # STORAGE=file için

# --- çekim ---
# PROBE_SOURCES=1     # İŞKUR/ilan.gov.tr için günlük tek anonim GET, sonucu kaynak durumuna yazar
# DETAIL_FETCH_LIMIT=60
# REQUEST_DELAY_MS=400
# SCHEDULE_TIMES=08:00,13:00,18:00   # yalnızca Cloud Scheduler yoksa (Türkiye saati)

# --- yapay zekâ (kapalıdır; sağlayıcı ve anahtar SUNUCUDA durur) ---
# AI_PROVIDER=anthropic         # anthropic | openai (OpenAI uyumlu) | gemini | off
# AI_MODEL=claude-opus-5-5
# AI_API_KEY=                   # Secret Manager'dan verin
# AI_BASE_URL=                  # yalnızca openai uyumlu/kendi barındırdığınız uçlar için
# AI_MAX_TOKENS_PARAM=max_tokens  # ya da max_completion_tokens
# AI_JSON_MODE=0
# AI_SUMMARY=1                  # doğrulanmış alıntılı özet
# AI_FIELDS=                    # ölçüm kapısı (tool/eval_ai.dart) geçen alanlar: maxAge,education,kpssType,quotaType
# AI_MIN_CONFIDENCE=0.9
# AI_BUDGET_TOKENS=300000       # çalışma başına token tavanı

# --- API ---
# PORT=8080
# WRITES_PER_HOUR_PER_IP=30
